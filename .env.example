# Binance Trading Bot Configuration

# Binance API credentials (get from https://www.binance.com/en/my/settings/api-management)
BOT_BINANCE_API_KEY=your_api_key_here
BOT_BINANCE_API_SECRET=your_api_secret_here

# Use Binance testnet (recommended for testing)
BOT_BINANCE_TESTNET=true

# Paper trading mode (simulated, no real money)
BOT_PAPER_TRADING=true

# Initial simulated balance in BRL
BOT_INITIAL_BALANCE_BRL=1000.0

# Risk management
BOT_MAX_RISK_PER_TRADE=0.02
BOT_MAX_OPEN_POSITIONS=5

# Grid Trading defaults
BOT_GRID_LEVELS=10
BOT_GRID_SPREAD_PERCENT=1.0

# DCA defaults
BOT_DCA_INTERVAL_MINUTES=60
BOT_DCA_AMOUNT_BRL=50.0

# Auto-Invest
BOT_AUTO_INVEST_ENABLED=false
BOT_AUTO_INVEST_TOP_N=5
BOT_AUTO_INVEST_REBALANCE_HOURS=4

# Server
BOT_HOST=0.0.0.0
BOT_PORT=8000
